# Copy to .env (never commit .env). The server reads this file via process.loadEnvFile().
# With LLM_PROVIDER=mock everything runs fully offline — no API key needed.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai (Llama also uses the OpenAI chat API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for live transcription (GET /api/scribe-token mints single-use
# ElevenLabs Scribe v2 Realtime tokens). Live practice fails without it.
ELEVENLABS_API_KEY=

# Port the server listens on; the client's Vite dev proxy points /api here.
PORT=3001
